{
  "name": "skor-panosu",
  "version": "0.4.0",
  "description": "Canlı skor overlay - animasyonlu skorboard",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "Lesbenjaminsss",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.benai.skorpanosu",
    "productName": "Skor Panosu",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Skor Panosu"
    }
  }
}
